{"id":"6dacd036-29a1-4a8d-ae14-e8d591aa8bea","kind":"api","category":"api","event":"removal","provider":"cloudflare","providerName":"Cloudflare","name":"Cloudflare API","modelId":null,"platform":null,"platformName":null,"version":null,"symbol":"DELETE /zones/{zone_id}/cache/origin_cloud_regions/{origin_ip}","title":"Cloudflare API: DELETE /zones/{zone_id}/cache/origin_cloud_regions/{origin_ip} is deprecated, removal on 2026-10-01","summary":"Removes the cloud region mapping for a single origin IP address. The IP path parameter is normalized before lookup. Returns the deleted entry on success. Returns 404 (code 1163) if no mapping exists for the specified IP. When the last mapping for the zone is removed the underlying rule record is also deleted.","date":"2026-10-01","dateKind":"hard","dates":[{"date":"2026-10-01","kind":"hard"}],"regions":null,"severity":"high","replacement":null,"source":{"url":"https://raw.githubusercontent.com/cloudflare/api-schemas/4b3c5f77343956ef946415ef8284cb4c72534d10/openapi.json","license":null},"announcedAt":"2026-11-20T22:46:20Z","updatedAt":"2026-11-20T22:46:20Z","url":"https://since.dev/calendar/cloudflare/api.cloudflare.com/delete-zones-zone-id-cache-origin-cloud-regions-origin-ip","release":null,"upgradeTo":null},
