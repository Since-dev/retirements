{"id":"0da3b76d-bf77-4e9d-bac2-63df3b60e862","kind":"api","category":"api","event":"removal","provider":"cloudflare","providerName":"Cloudflare","name":"Cloudflare API","modelId":null,"platform":null,"platformName":null,"version":null,"symbol":"POST /zones/{zone_id}/cache/origin_cloud_regions","title":"Cloudflare API: POST /zones/{zone_id}/cache/origin_cloud_regions is deprecated, removal on 2026-10-01","summary":"Adds a single IP-to-cloud-region mapping for the zone. The IP must be a valid IPv4 or IPv6 address and is normalized to canonical form before storage (RFC 5952 for IPv6). Returns 400 (code 1145) if a mapping for that IP already exists - use PATCH to update an existing entry. The vendor and region are validated against the list from `GET /zones/{zone_id}/cache/origin_cloud_regions/supported_regions`.","date":"2026-10-01","dateKind":"hard","dates":[{"date":"2026-10-01","kind":"hard"}],"regions":null,"severity":"high","replacement":null,"source":{"url":"https://raw.githubusercontent.com/cloudflare/api-schemas/4b3c5f77343956ef946415ef8284cb4c72534d10/openapi.json","license":null},"announcedAt":"2026-11-20T22:46:20Z","updatedAt":"2026-11-20T22:46:20Z","url":"https://since.dev/calendar/cloudflare/api.cloudflare.com/post-zones-zone-id-cache-origin-cloud-regions","release":null,"upgradeTo":null},
{"id":"3539b3e4-0a52-4b8f-9d28-269fc0409d9a","kind":"api","category":"api","event":"removal","provider":"cloudflare","providerName":"Cloudflare","name":"Cloudflare API","modelId":null,"platform":null,"platformName":null,"version":null,"symbol":"PATCH /zones/{zone_id}/cache/origin_cloud_regions","title":"Cloudflare API: PATCH /zones/{zone_id}/cache/origin_cloud_regions is deprecated, removal on 2026-10-01","summary":"Adds or updates a single IP-to-cloud-region mapping for the zone. Unlike POST, this operation is idempotent - if a mapping for the IP already exists it is overwritten. Returns the complete updated list of all mappings for the zone. Returns 403 (code 1164) when the zone has reached the limit of 3,500 IP mappings.","date":"2026-10-01","dateKind":"hard","dates":[{"date":"2026-10-01","kind":"hard"}],"regions":null,"severity":"high","replacement":null,"source":{"url":"https://raw.githubusercontent.com/cloudflare/api-schemas/4b3c5f77343956ef946415ef8284cb4c72534d10/openapi.json","license":null},"announcedAt":"2026-11-20T22:46:20Z","updatedAt":"2026-11-20T22:46:20Z","url":"https://since.dev/calendar/cloudflare/api.cloudflare.com/patch-zones-zone-id-cache-origin-cloud-regions","release":null,"upgradeTo":null},
