{"id":"87cdd477-c4ae-4f29-9d47-a298e4431cbb","kind":"api","category":"api","event":"removal","provider":"cloudflare","providerName":"Cloudflare","name":"Cloudflare API","modelId":null,"platform":null,"platformName":null,"version":null,"symbol":"GET /zones/{zone_id}/cache/origin_cloud_regions","title":"Cloudflare API: GET /zones/{zone_id}/cache/origin_cloud_regions is deprecated, removal on 2026-10-01","summary":"Returns all IP-to-cloud-region mappings configured for the zone. Each mapping tells Cloudflare which cloud vendor and region hosts the origin at that IP, enabling the edge to route via the nearest Tiered Cache upper-tier co-located with that cloud provider. Returns an empty array when no mappings exist.","date":"2026-10-01","dateKind":"hard","dates":[{"date":"2026-10-01","kind":"hard"}],"regions":null,"severity":"high","replacement":null,"source":{"url":"https://raw.githubusercontent.com/cloudflare/api-schemas/4b3c5f77343956ef946415ef8284cb4c72534d10/openapi.json","license":null},"announcedAt":"2026-11-20T22:46:20Z","updatedAt":"2026-11-20T22:46:20Z","url":"https://since.dev/calendar/cloudflare/api.cloudflare.com/get-zones-zone-id-cache-origin-cloud-regions","release":null,"upgradeTo":null},
